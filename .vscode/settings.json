{
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    { "pattern": "./backend" },
    { "pattern": "./frontend" }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  }
}
